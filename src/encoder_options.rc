#include <windows.h>
#pragma code_page(65001)
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
201 DIALOGEX 0, 0, 310, 104
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "RealAudio ATRAC3 编码设置"
FONT 9, "Tahoma"
BEGIN
    LTEXT "输出码率：", -1, 10, 13, 52, 12
    COMBOBOX 1001, 66, 10, 234, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "输出为 44.1 kHz 立体声，保存为 RM 文件。", 1002, 10, 36, 290, 12
    LTEXT "输入的采样率和位深会自动转换；单声道复制到左右声道。", 1003, 10, 53, 290, 22
    DEFPUSHBUTTON "确定", IDOK, 192, 82, 50, 14
    PUSHBUTTON "取消", IDCANCEL, 250, 82, 50, 14
END
